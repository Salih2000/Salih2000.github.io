{% capture footer_contents %}
  &copy;
  {{- site.data[site.active_lang].strings.footer.copyright }}
  {{ site.time | date: '%Y' }}
  {{ site.data[site.active_lang].strings.name.first }}
  {{ site.data[site.active_lang].strings.name.middle }}
  {{ site.data[site.active_lang].strings.name.last }}. {{ site.data[site.active_lang].strings.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    {{- site.data[site.active_lang].strings.footer.last_updated }}
    {% include date_format.liquid format='long' date='now' %}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
