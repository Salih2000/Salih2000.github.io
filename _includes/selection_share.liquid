{% comment %}
  Sharing a passage of a post: selecting at least two words of the post shows this bar next to the selection
  (assets/js/selection-share.js moves it under <body> and fills in the addresses). Every link shares the selected text
  together with a link that opens the post at that passage. A right click keeps the browser's own menu with Copy: the
  owner tried data-right-click="true", which opens the bar there instead, and turned it off again (2026-11-16).
{% endcomment %}
{% assign share_strings = site.data[site.active_lang].strings.share %}
{% assign share_path = page.url | replace: 'index.html', '' %}
{% if site.active_lang == site.default_lang %}
  {% capture passage_base %}{{ site.url }}{{ site.baseurl }}{{ share_path }}{% endcapture %}
{% else %}
  {% capture passage_base %}{{ site.url }}{{ site.baseurl }}/{{ site.active_lang }}{{ share_path }}{% endcapture %}
{% endif %}

<style>
  .selection-share {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1020;
    display: flex;
    flex-direction: column;
    max-width: calc(100vw - 16px);
    padding: 0.25rem;
    border-radius: 0.5rem;
    background: var(--global-text-color);
    color: var(--global-bg-color);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    font-size: 0.875rem;
    line-height: 1.4;
    -webkit-user-select: none;
    user-select: none;
  }
  /* The theme colours every div, p and span with the text colour; inside the bar they take the bar's own colour. */
  .selection-share * {
    color: inherit;
  }
  .selection-share[hidden],
  .selection-share [hidden] {
    display: none !important;
  }
  .selection-share-buttons {
    display: flex;
    gap: 0.125rem;
  }
  .selection-share-buttons a,
  .selection-share-buttons button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    font-size: 1.05rem;
    text-decoration: none;
    cursor: pointer;
  }
  .selection-share-buttons a:hover,
  .selection-share-buttons button:hover {
    background: rgba(128, 128, 128, 0.35);
    color: inherit;
  }
  .selection-share a:focus-visible,
  .selection-share button:focus-visible,
  .selection-share-message:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }
  .selection-share-message {
    max-width: 18rem;
    margin: 0;
    padding: 0.375rem 0.5rem;
    font-weight: 400;
  }
  /* Empty, it stays rendered with no height, so that screen readers announce the text it gets. */
  .selection-share-message:empty {
    padding: 0;
  }
  /* An enlarged image covers the page, and the bar would sit on top of it. */
  body.medium-zoom--opened .selection-share {
    display: none !important;
  }
  .selection-share a.selection-share-go {
    margin: 0 0.5rem 0.375rem;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
  }
  .selection-share::after {
    content: '';
    position: absolute;
    top: 100%;
    left: var(--arrow-left, 50%);
    margin-left: -6px;
    border: 6px solid transparent;
    border-top-color: var(--global-text-color);
  }
  .selection-share.is-below::after {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom-color: var(--global-text-color);
  }
  .selection-share.no-arrow::after {
    display: none;
  }
  @media (pointer: coarse) {
    .selection-share-buttons a,
    .selection-share-buttons button {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>

<div
  class="selection-share"
  role="group"
  aria-label="{{ share_strings.selection }}"
  data-url="{{ passage_base | strip }}"
  data-title="{{ page.title | strip | escape }}"
  data-right-click="false"
  hidden
>
  <div class="selection-share-buttons">
    <button type="button" data-share="linkedin" aria-label="{{ share_strings.selection }}: LinkedIn" title="LinkedIn">
      <i class="fa-brands fa-linkedin"></i>
    </button>
    <a data-share="x" href="https://x.com/" target="_blank" rel="noopener" aria-label="{{ share_strings.selection }}: X" title="X"
      ><i class="fa-brands fa-x-twitter"></i
    ></a>
    <a
      data-share="whatsapp"
      href="https://api.whatsapp.com/"
      target="_blank"
      rel="noopener"
      aria-label="{{ share_strings.selection }}: WhatsApp"
      title="WhatsApp"
      ><i class="fa-brands fa-whatsapp"></i
    ></a>
    <button type="button" data-share="copy" aria-label="{{ share_strings.passage_link }}" title="{{ share_strings.passage_link }}">
      <i class="fa-solid fa-link"></i>
    </button>
    <button type="button" data-share="native" aria-label="{{ share_strings.more }}" title="{{ share_strings.more }}" hidden>
      <i class="fa-solid fa-share-nodes"></i>
    </button>
  </div>
  <p
    class="selection-share-message"
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-copied="{{ share_strings.passage_copied }}"
    data-linkedin="{{ share_strings.linkedin_copied }}"
  ></p>
  <a class="selection-share-go" href="https://www.linkedin.com/" target="_blank" rel="noopener" hidden>{{ share_strings.linkedin_open }}</a>
</div>
<script defer src="{{ '/assets/js/selection-share.js' | relative_url | bust_file_cache }}"></script>
