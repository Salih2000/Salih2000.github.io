{% comment %}
  The author's other posts, listed at the very end of a post, under the comments. site.related_posts holds the most
  recent posts in the page's language, without the current one. The heading stays out of the sidebar table of contents,
  and the bottom margin keeps the last link clear of the fixed footer. The newsletter form is not repeated here: the post
  layout already shows it under the share buttons.
{% endcomment %}
{% assign related_title = site.data[site.active_lang].strings.related_posts.title %}
{% assign related_count = site.related_posts | size %}
{% if related_count > 0 %}
  <style>
    .related-posts {
      margin-top: 2.5rem;
      margin-bottom: 4rem;
      padding-top: 1rem;
      border-top: 1px solid var(--global-divider-color);
    }
    .related-posts h2 {
      margin-bottom: 0.75rem;
      font-size: 1.4rem;
    }
    .related-posts ul {
      padding-left: 1.25rem;
    }
    .related-posts li {
      margin: 0.4rem 0;
    }
  </style>
  <nav class="related-posts" aria-label="{{ related_title }}">
    <h2 data-toc-skip>{{ related_title }}</h2>
    <ul>
      {% for post in site.related_posts limit: site.related_blog_posts.max_related %}
        <li>
          {% if post.redirect == blank %}
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
          {% elsif post.redirect contains '://' %}
            <a href="{{ post.redirect }}" target="_blank" rel="noopener">{{ post.title }}</a>
          {% else %}
            <a href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
