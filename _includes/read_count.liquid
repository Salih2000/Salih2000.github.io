{% comment %}
  Read count of a blog post. _layouts/post.liquid shows it at the end of the post header line; the blog list
  (_pages/*/blog.md) shows it for each post with include.post set to that post and include.separator set to its own
  separator. assets/js/read-count.js fills in the numbers and, on the post page only, adds this browser's first read;
  GoatCounter keeps the numbers (read_counts in _config.yml). The count belongs to the article, not to a language: the
  Turkish and English copies share the file name, so they share the slug. A copy with another file name can set
  read_count_key in its front matter to join the same count.
{% endcomment %}
{% if site.read_counts.goatcounter %}
  {% if include.post %}
    {% assign read_post = include.post %}
  {% else %}
    {% assign read_post = page %}
  {% endif %}
  {% assign read_strings = site.data[site.active_lang].strings.post %}
  {% assign read_key = read_post.read_count_key | default: read_post.slug %}
  {% assign read_host = site.url | remove: 'https://' | remove: 'http://' | split: '/' | first | split: ':' | first %}
  <span
    class="read-count"
    data-read-count
    {% unless include.post %}
      data-read-count-own
    {% endunless %}
    data-goatcounter="{{ site.read_counts.goatcounter }}"
    data-path="/read/{{ read_key }}"
    data-host="{{ read_host }}"
    data-label-one="{{ read_strings.reads_one }}"
    data-label-other="{{ read_strings.reads_other }}"
    hidden
  >
    {{- include.separator | default: '•' }}
    <span data-read-count-number></span> <span data-read-count-label></span
  ></span>
{% endif %}
