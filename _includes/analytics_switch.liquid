{% comment %}
  Keeps the site owner's own visits, and those of people he gives the link to, out of the statistics. Opening any page
  of the site with the secret key after a # turns Google Analytics, Microsoft Clarity and GoatCounter off in that
  browser and remembers it in localStorage; #analytics-on turns them back on. The key itself is not in this repository:
  only its SHA-256 is, so reading the code does not give it away. To replace the key, pick a new random one of at least
  24 letters, digits, "-" or "_", and put its SHA-256 (lowercase hex) in KEY_SHA256.

  GoatCounter's count.js already skips a browser whose localStorage "skipgc" is "t", so the switch sets that key as
  well. Clearing the browser's site data forgets the setting, and a browser that blocks site data for this site cannot
  keep it.
{% endcomment %}
<script>
  (function () {
    var KEY_SHA256 = '20163a109898b02d9fd5f0a4f999f9c640031c570007d3f34d09a8f42dad0a72';
    var code = location.hash.slice(1);
    var off = false;
    try {
      if (code === 'analytics-on') {
        localStorage.removeItem('analytics-off');
        localStorage.removeItem('skipgc');
      }
      off = localStorage.getItem('analytics-off') === '1';
    } catch (e) {}
    // A long code after the # may be the key. This page view stays out while it is checked; if it is the key, the
    // browser remembers it and the key is taken out of the address bar so it is not copied along with the link.
    if (!off && /^[A-Za-z0-9_-]{24,}$/.test(code) && window.crypto && crypto.subtle && window.TextEncoder) {
      off = true;
      crypto.subtle.digest('SHA-256', new TextEncoder().encode(code)).then(function (buffer) {
        var hex = Array.prototype.map
          .call(new Uint8Array(buffer), function (byte) {
            return ('0' + byte.toString(16)).slice(-2);
          })
          .join('');
        if (hex !== KEY_SHA256) return;
        try {
          localStorage.setItem('analytics-off', '1');
          localStorage.setItem('skipgc', 't');
        } catch (e) {}
        history.replaceState(null, '', location.pathname + location.search);
        console.info('Analytics are off in this browser for this site.');
      });
    }
    window.analyticsOff = off;
  })();
</script>
