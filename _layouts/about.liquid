---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.data[site.active_lang].strings.name.first }}</span>
        {{ site.data[site.active_lang].strings.name.middle }}
        {{ site.data[site.active_lang].strings.name.last }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}
      {% assign subtitle_chars = page.subtitle | split: '' %}
      {%- comment -%}
        Timeline: drop-in -> one-shot per-letter glow sweep -> a single synchronized heartbeat
        pulse (all letters at once) -> a 6s pause -> the glow sweep resumes, now looping every 6s
        forever. sweep_end is when the *last* letter's one-shot sweep flash finishes (its own
        glow delay plus the ~1.2s the flash takes to rise and fade, i.e. the 0%-20% span of
        letter-glow's 6s duration), so the heartbeat only starts once every letter has finished
        sweeping. loop_start likewise waits out the heartbeat's own 1.8s duration before adding
        the 6s pause.
      {%- endcomment -%}
      {% assign last_index = subtitle_chars.size | minus: 1 %}
      {% assign sweep_end = last_index | times: 0.08 | plus: 1.2 %}
      {% assign heartbeat_delay = sweep_end | plus: 0.2 %}
      {% assign loop_start = heartbeat_delay | plus: 7.8 %}
      <p class="desc hello-animated">
        {% for char in subtitle_chars -%}
          {%- assign drop_delay = forloop.index0 | times: 0.05 -%}
          {%- assign glow_delay = forloop.index0 | times: 0.08 -%}
          {%- assign loop_delay = loop_start | plus: glow_delay -%}
          <span
            class="letter"
            style="animation-delay: {{ drop_delay }}s, {{ glow_delay }}s, {{ heartbeat_delay }}s, {{ loop_delay }}s;"
          >
            {%- if char == ' ' %}&nbsp;{% else %}{{ char }}{% endif -%}
          </span>
        {%- endfor %}
      </p>
    {% endif %}
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.news }}</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.latest_posts }}</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.selected_publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.data[site.active_lang].strings.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
