---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.data[site.active_lang].strings.name.first }}</span>
        {{ site.data[site.active_lang].strings.name.middle }}
        {{ site.data[site.active_lang].strings.name.last }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}
      {% assign subtitle_chars = page.subtitle | split: '' %}
      {%- comment -%}
        Timeline: drop-in -> one-shot per-letter glow sweep -> a single synchronized heartbeat
        pulse (all letters at once) -> a 6s pause -> the glow sweep resumes, now looping every 6s
        forever. sweep_end is when the *last* letter's one-shot sweep flash finishes (its own
        glow delay plus the ~1.2s the flash takes to rise and fade, i.e. the 0%-20% span of
        letter-glow's 6s duration), so the heartbeat only starts once every letter has finished
        sweeping. loop_start likewise waits out the heartbeat's own 1.8s duration before adding
        the 6s pause.
      {%- endcomment -%}
      {% assign last_index = subtitle_chars.size | minus: 1 %}
      {% assign sweep_end = last_index | times: 0.08 | plus: 1.2 %}
      {% assign heartbeat_delay = sweep_end | plus: 0.2 %}
      {% assign loop_start = heartbeat_delay | plus: 7.8 %}
      {%- comment -%}
        The greeting's easter egg (script below) plays a different YouTube clip per language.
      {%- endcomment -%}
      {% if site.active_lang == 'tr-tur' %}
        {% assign egg = 'hJTc2_-3-Yg|181|205|Merhaba ey cân-ı cânân|Merhaba|tr-TR|/assets/audio/merhaba.mp3' | split: '|' %}
      {% else %}
        {% assign egg = 'rEq1Z0bjdwc|8|10|Obi-Wan: Hello there|Hello there|en-GB|/assets/audio/hello-there.mp3' | split: '|' %}
      {% endif %}
      <p
        class="desc hello-animated"
        data-clip-id="{{ egg[0] }}"
        data-clip-start="{{ egg[1] }}"
        data-clip-end="{{ egg[2] }}"
        data-clip-title="{{ egg[3] }}"
        data-voice-text="{{ egg[4] }}"
        data-voice-lang="{{ egg[5] }}"
        data-audio-file="{{ egg[6] }}"
      >
        {% for char in subtitle_chars -%}
          {%- assign drop_delay = forloop.index0 | times: 0.05 -%}
          {%- assign glow_delay = forloop.index0 | times: 0.08 -%}
          {%- assign loop_delay = loop_start | plus: glow_delay -%}
          <span
            class="letter"
            style="animation-delay: {{ drop_delay }}s, {{ glow_delay }}s, {{ heartbeat_delay }}s, {{ loop_delay }}s;"
          >
            {%- if char == ' ' %}&nbsp;{% else %}{{ char }}{% endif -%}
          </span>
        {%- endfor %}
      </p>
      <script>
        // Easter egg: seven quick clicks on the greeting answer it. While the clip named in the greeting's data-clip-*
        // attributes is still on YouTube, a small YouTube player plays that part of it (English: Obi-Wan's "Hello there";
        // Turkish: "Merhaba ey cân-ı cânân"); the site keeps no copy of either. Otherwise data-audio-file plays if it is
        // set and exists, and failing that, a browser voice says data-voice-text.
        (function () {
          var greeting = document.currentScript && document.currentScript.previousElementSibling;
          if (!greeting || !greeting.classList.contains('hello-animated')) return;
          var egg = greeting.dataset;
          var VIDEO_ID = egg.clipId;
          var count = 0;
          var last = 0;
          var check = null;

          function checkVideo() {
            if (!check) {
              check = window.fetch
                ? fetch('https://www.youtube.com/oembed?format=json&url=' + encodeURIComponent('https://www.youtube.com/watch?v=' + VIDEO_ID), {
                    credentials: 'omit',
                  })
                    .then(function (response) {
                      return response.ok;
                    })
                    .catch(function () {
                      return false;
                    })
                : Promise.resolve(false);
            }
            return check;
          }

          function speak() {
            if (!('speechSynthesis' in window)) return;
            var line = new SpeechSynthesisUtterance(egg.voiceText);
            line.lang = egg.voiceLang;
            line.rate = 0.85;
            line.pitch = 0.9;
            var british = window.speechSynthesis.getVoices().filter(function (voice) {
              return voice.lang.toLowerCase().indexOf(egg.voiceLang.toLowerCase()) === 0;
            });
            if (british.length) line.voice = british[0];
            window.speechSynthesis.cancel();
            window.speechSynthesis.speak(line);
          }

          function playFile() {
            var fellBack = false;
            var fallback = function () {
              if (fellBack) return;
              fellBack = true;
              speak();
            };
            if (!egg.audioFile) return fallback();
            var clip = new Audio(egg.audioFile);
            clip.addEventListener('error', fallback);
            var started = clip.play();
            if (started && started.catch) started.catch(fallback);
          }

          function showClip() {
            var old = document.querySelector('.hello-there-clip');
            if (old) old.remove();
            if (!document.getElementById('hello-there-clip-style')) {
              var style = document.createElement('style');
              style.id = 'hello-there-clip-style';
              style.textContent =
                '.hello-there-clip{position:fixed;right:16px;bottom:72px;z-index:1050;width:356px;max-width:calc(100vw - 32px);padding:6px;' +
                'border:1px solid var(--global-divider-color);border-radius:8px;background:var(--global-card-bg-color);box-shadow:0 4px 18px rgba(0,0,0,.25)}' +
                '.hello-there-clip iframe{display:block;width:100%;height:200px;border:0;border-radius:4px}' +
                '.hello-there-clip button{position:absolute;top:-12px;right:-12px;width:28px;height:28px;padding:0;border-radius:50%;' +
                'border:1px solid var(--global-divider-color);background:var(--global-card-bg-color);color:var(--global-text-color);line-height:1;cursor:pointer}';
              document.head.appendChild(style);
            }
            var box = document.createElement('div');
            box.className = 'hello-there-clip';
            box.setAttribute('role', 'dialog');
            box.setAttribute('aria-label', 'Hello there');
            var frame = document.createElement('iframe');
            frame.src =
              'https://www.youtube-nocookie.com/embed/' +
              VIDEO_ID +
              '?start=' +
              egg.clipStart +
              '&end=' +
              egg.clipEnd +
              '&autoplay=1&rel=0&playsinline=1';
            frame.title = egg.clipTitle;
            frame.allow = 'autoplay; encrypted-media; picture-in-picture';
            frame.referrerPolicy = 'strict-origin-when-cross-origin';
            var close = document.createElement('button');
            close.type = 'button';
            close.setAttribute('aria-label', 'Close');
            close.textContent = '×';
            close.addEventListener('click', function () {
              box.remove();
            });
            box.appendChild(frame);
            box.appendChild(close);
            document.body.appendChild(box);
            setTimeout(
              function () {
                box.remove();
              },
              (Number(egg.clipEnd) - Number(egg.clipStart) + 10) * 1000
            );
          }

          greeting.addEventListener('click', function () {
            var now = Date.now();
            count = now - last < 1500 ? count + 1 : 1;
            last = now;
            if (count === 2) checkVideo();
            if (count === 7) {
              count = 0;
              var wait = new Promise(function (resolve) {
                setTimeout(function () {
                  resolve(false);
                }, 1000);
              });
              Promise.race([checkVideo(), wait]).then(function (available) {
                if (available) showClip();
                else playFile();
              });
            }
          });
        })();
      </script>
    {% endif %}
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {% capture profile_image_alt %}{{ site.data[site.active_lang].strings.name.first }} {{ site.data[site.active_lang].strings.name.last }}{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.news }}</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.latest_posts }}</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.selected_publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.data[site.active_lang].strings.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
